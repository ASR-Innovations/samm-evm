# ─── Required ──────────────────────────────────────────────────
PRIVATE_KEY=your_private_key_here_without_0x_prefix
RISECHAIN_RPC_URL=https://testnet.riselabs.xyz/http

# ─── API Server ────────────────────────────────────────────────
PORT=3000

# ─── Arbitrage Bot ─────────────────────────────────────────────
ENABLE_ARBITRAGE=true
ARB_CHECK_INTERVAL=20000

# ─── Dynamic Shard Manager ────────────────────────────────────
ENABLE_DYNAMIC_SHARDING=true
SHARD_CHECK_INTERVAL=60000
PER_SHARD_TPS=50
TPS_WINDOW=300
MIN_TPS_FOR_SCALE_UP=5

# ─── Uniswap Integration ──────────────────────────────────────
UNISWAP_API_KEY=your_uniswap_api_key_here

# ─── Chainlink Integration ────────────────────────────────────
SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/your_infura_key

# ─── ENS Integration ──────────────────────────────────────────
ENABLE_ENS=true
ENS_RPC_URL=https://ethereum.publicnode.com
ENS_BASE_DOMAIN=samm.eth
ENS_ARB_BOT_NAME=arb-bot
ENS_SHARD_MANAGER_NAME=shard-manager
ENS_REGISTRY_ADDRESS=
ENS_SYNC_INTERVAL_MS=120000

# Block Explorer API Keys (for contract verification)
ETHERSCAN_API_KEY=your_etherscan_api_key_here
MONAD_API_KEY=your_monad_explorer_api_key_here
RISECHAIN_API_KEY=your_risechain_explorer_api_key_here

# Deployment Options
AUTO_INITIALIZE=false
INITIAL_LIQUIDITY_A=10000
INITIAL_LIQUIDITY_B=10000
TRADE_FEE_NUMERATOR=25
TRADE_FEE_DENOMINATOR=10000
OWNER_FEE_NUMERATOR=10
OWNER_FEE_DENOMINATOR=10000