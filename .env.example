# ── Solana network ───────────────────────────────────────────────
SOLANA_RPC_URL=https://api.devnet.solana.com
# SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# ── Program (populated by npm run deploy:solana) ─────────────────
SOLANA_PROGRAM_ID=

# ── Wallet (base58 secret key — never commit real keys) ──────────
SOLANA_PRIVATE_KEY=

# ── Deployment file (default: solana-devnet.json) ─────────────────
# DEPLOYMENT_FILE=solana-devnet.json

# ── Backend ───────────────────────────────────────────────────────
PORT=3000

# ── Bot controls ─────────────────────────────────────────────────
ENABLE_ARBITRAGE=true
ENABLE_DYNAMIC_SHARDING=true
ARB_CHECK_INTERVAL=30000
SHARD_CHECK_INTERVAL=60000

# ── Shard scaling ─────────────────────────────────────────────────
MAX_SHARDS_PER_PAIR=10
PER_SHARD_TPS=50
# ENABLE_AUTO_SHARD_CREATE=true
