  "routing": {
    "onChain": true,
    "singleHop": {
      "opcode": 0,
      "maxShardsPerTx": 3,
      "txSizeBytes": "~1053 bytes (3 shards × 6 accounts + 7 fixed)",
      "description": "Router reads reserves from all provided shards, selects lowest amountIn, executes atomically"
    },
    "multiHop": {
      "opcode": 1,
      "maxShardsPerHop": 1,
      "txSizeBytes": "~931 bytes (2 hops × 1 shard × 6 accounts + 9 fixed)",
      "description": "Backward quote (hop-2 first), forward execute (hop-1 then hop-2) — one tx, one signature"
    },
    "invariants": {
      "cNonSplitting": "c=0.96: if amountOut < 0.96×destReserve, single-shard is provably optimal",
      "smallerBetter": "Larger pools require less amountIn for same amountOut — router enforces automatically"
    }
  },
  "api": {
    "baseUrl": "http://localhost:3000",
    "endpoints": {
      "health": {
        "method": "GET",
        "path": "/health",
        "description": "Server status, oracle prices, arb bot stats, router program ID",
        "response": "{ status, programId, routerProgramId, oraclePrices, wallet, arbitrageBot, shardManager }"
      },
      "tokens": {
        "method": "GET",
        "path": "/tokens",
        "description": "All tokens with live oracle prices",
        "response": "{ tokens: [{ symbol, mint, decimals, price }] }"
      },
      "pools": {
        "method": "GET",
        "path": "/pools",
        "description": "All pairs with shard TVL",
        "response": "{ pools: [{ pair, shards: [...], totalLiquidityUSD }] }"
      },
      "poolsForPair": {
        "method": "GET",
        "path": "/pools/:tokenA/:tokenB",
        "example": "/pools/WETH/USDC",
        "description": "Shards for a specific pair with live reserves",
        "response": "{ pair, shards: [{ name, address, tokenA, tokenB, reserveA, reserveB, liquidityUSD }] }"
      },
      "quoteGet": {
        "method": "GET",
        "path": "/quote/:tokenIn/:tokenOut/:amountOut",
        "example": "/quote/USDC/WETH/0.001",
        "description": "Quick routing quote with full hop breakdown",
        "response": "{ tokenIn, tokenOut, amountOut, amountIn, amountInUSD, amountOutUSD, effectiveRate, slippagePct, totalFee, totalFeeBps, routePath, hops, hopDetails }"
      },
      "quotePost": {
        "method": "POST",
        "path": "/quote",
        "body": "{ tokenIn, tokenOut, amountOut }",
        "description": "Same as GET /quote — use POST for complex integration"
      },
      "swap": {
        "method": "POST",
        "path": "/swap",
        "body": "{ tokenIn, tokenOut, amountOut, slippagePct? }",
        "example": "{ tokenIn:USDC,tokenOut:WETH,amountOut:0.001,slippagePct:1.0 }",
        "description": "Execute via on-chain router. Router selects best shard, enforces c-Non-Splitting + Smaller-Better, CPIs to SAMM atomically.",
        "response": "{ success, txHash, tokenIn, tokenOut, amountOut, amountIn, routePath, hops, routing:on-chain, feeBps, priceImpactPct, explorer }"
      },
      "price": {
        "method": "GET",
        "path": "/price/:tokenA/:tokenB",
        "example": "/price/USDC/WETH",
        "description": "Live spot price with oracle deviation",
        "response": "{ pair, price, description, oracleRate, deviationPct, routePath, feeBps }"
      },
      "balance": {
        "method": "GET",
        "path": "/balance/:address/:token",
        "example": "/balance/3192e7.../USDC",
        "description": "Single token balance for a wallet",
        "response": "{ address, token, balance, balanceRaw }"
      },
      "balances": {
        "method": "GET",
        "path": "/balances/:address",
        "description": "All token balances for a wallet",
        "response": "{ address, balances: { USDC: { balance, balanceRaw, decimals, mint }, ... } }"
      },
      "stats": {
        "method": "GET",
        "path": "/stats",
        "description": "DEX-wide stats: TVL per pair, total liquidity, oracle prices",
        "response": "{ totalPairs, totalShards, totalLiquidityUSD, pairs: { pair: { shards, liquidityUSD } } }"
      },
      "arbStatus": {
        "method": "GET",
        "path": "/arbitrage/status",
        "description": "Arb bot status + recent swaps",
        "response": "{ running, cycles, swaps, totalUSD, recentSwaps }"
      },
      "arbHistory": {
        "method": "GET",
        "path": "/arbitrage/history?limit=20",
        "description": "Full arb swap history with pre/post deviation"
      },
      "shardStatus": {
        "method": "GET",
        "path": "/sharding/status",
        "description": "Shard manager status + active/inactive counts"
      },
      "faucet": {
        "method": "POST",
        "path": "/faucet",
        "body": "{ address, tokens?: { USDC: 1000, WETH: 0.5 } }",
        "description": "Devnet only: mint test tokens to any wallet (server is mint authority)",
        "maxAmounts": "USDC/USDT/DAI: 10000, WETH: 5, WBTC: 0.1 per call"
      }
    }
  }
}