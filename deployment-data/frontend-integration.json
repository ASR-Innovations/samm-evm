  "routing": {
    "description": "On-chain trustless shard selection via samm-router program",
    "singleHop": "routeSwap (opcode 0): router reads live reserves, selects best shard via SAMM adaptive-fee formula, enforces c-Non-Splitting (c=0.96) and Smaller-Better Principle, issues CPI atomically",
    "multiHop": "routeSwapMulti (opcode 1): backward quote (hop-2 first), then forward execute (hop-1 then hop-2) — all in ONE atomic transaction, ONE user signature",
    "maxShardsPerHop": {
      "singleHop": 3,
      "multiHop": 1
    },
    "cNonSplitting": "c=0.96: if amountOut < 0.96 × destReserve, single-shard is provably optimal",
    "smallerBetter": "Larger reserve pool requires less amountIn for same amountOut — on-chain selection is automatic"
  }
